<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yx.system.mapper.RuleConfigHistoryMapper">
    <resultMap id="RuleHistory" type="com.yx.system.domain.configversion.RuleConfigRecord">
        <id column="id" property="id"/>
        <result column="config_key" property="configKey"/>
        <result column="scope" property="scope"/>
        <result column="config_value" property="configValue"/>
        <result column="effective_from" property="effectiveFrom"/>
        <result column="effective_to" property="effectiveTo"/>
        <result column="revoked_at" property="revokedAt"/>
    </resultMap>
    <!-- 返回全部历史，不能使用当前 status 或 revoked_at IS NULL 过滤。 -->
    <select id="findHistory" resultMap="RuleHistory" useCache="false" flushCache="true">
        SELECT id, config_key, scope, config_value, effective_from, effective_to, revoked_at
        FROM noon_rule_config
        WHERE config_key = #{key} AND scope IN (#{site}, 'GLOBAL')
        ORDER BY scope, effective_from, id
    </select>
</mapper>
